{
  "family": "jobtory-backend-task",
  "executionRoleArn": "arn:aws:iam::816292901195:role/jobtory-ecs-task-execution",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "3072",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "jobtory-backend",
      "image": "816292901195.dkr.ecr.ap-northeast-2.amazonaws.com/jobtory-backend:latest",
      "essential": true,
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "appProtocol": "http",
          "name": "jobtory-backend-8000-tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/jobtory-backend-task",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "/jobtory/prod/DB_HOST"
        },
        {
          "name": "DB_NAME",
          "valueFrom": "/jobtory/prod/DB_NAME"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "/jobtory/prod/DB_PASSWORD"
        },
        {
          "name": "DB_PORT",
          "valueFrom": "/jobtory/prod/DB_PORT"
        },
        {
          "name": "DB_USER",
          "valueFrom": "/jobtory/prod/DB_USER"
        },
        {
          "name": "DJANGO_ALLOWED_HOSTS",
          "valueFrom": "/jobtory/prod/DJANGO_ALLOWED_HOSTS"
        },
        {
          "name": "DJANGO_DEBUG",
          "valueFrom": "/jobtory/prod/DJANGO_DEBUG"
        },
        {
          "name": "DJANGO_SECRET_KEY",
          "valueFrom": "/jobtory/prod/DJANGO_SECRET_KEY"
        },
        {
          "name": "ELASTICSEARCH_HOST",
          "valueFrom": "/jobtory/prod/ELASTICSEARCH_HOST"
        },
        {
          "name": "ES_URL",
          "valueFrom": "/jobtory/prod/ES_URL"
        },
        {
          "name": "FRONTEND_BASE_URL",
          "valueFrom": "/jobtory/prod/FRONTEND_BASE_URL"
        },
        {
          "name": "GOOGLE_REDIRECT_URI",
          "valueFrom": "/jobtory/prod/GOOGLE_REDIRECT_URI"
        },
        {
          "name": "NEO4J_AUTH",
          "valueFrom": "/jobtory/prod/NEO4J_AUTH"
        },
        {
          "name": "NEO4J_HTTP_URL",
          "valueFrom": "/jobtory/prod/NEO4J_HTTP_URL"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "/jobtory/prod/REDIS_URL"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "/jobtory/prod/OPENAI_API_KEY"
        }
      ],
      "environment": [],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "ulimits": [],
      "systemControls": []
    }
  ],
  "volumes": [],
  "placementConstraints": []
}